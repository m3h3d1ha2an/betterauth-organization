{
  "name": "betterauth-organization",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f .env.development --convention=nextjs -- next dev",
    "build": "dotenvx run -f .env.development --convention=nextjs -- next build",
    "start": "dotenvx run -f .env.development --convention=nextjs -- next start",
    "fix": "biome check --write",
    "fmt": "biome format --write && prisma format",
    "type": "tsc --noEmit",
    "db:gen": "dotenvx run -f .env.development --overload -- prisma generate",
    "db:mig": "dotenvx run -f .env.development --overload -- prisma migrate dev",
    "db:push": "dotenvx run -f .env.development --overload -- prisma db push",
    "db:studio": "dotenvx run -f .env.development --overload -- prisma studio",
    "db:reset": "dotenvx run -f .env.development --overload -- prisma migrate reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.5",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-form": "^1.28.2",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@dotenvx/dotenvx": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "msw",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
